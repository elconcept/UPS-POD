# Wzór pliku rozruchowego /volume2/docker/ups-pod/.env (czytany przez CI/CD).
# Panel Konfiguracja zapisuje aktualne dane w /volume2/docker/ups-pod/data/.env.
# Nie wpisuj prawdziwych danych do repozytorium.
client_id=
client_secret=
# UPS_SHIPPER_NUMBER=
# Dopuszczalne alternatywne nazwy: UPS_CLIENT_ID i UPS_CLIENT_SECRET.

# UPS Tracking: prefer English locale for verbatim UPS statuses (Delivery Rescheduled).
# UPS_TRACKING_LOCALE=en_US
#
# Support mail: send ONLY on explicit user click; missing SMTP = no send.
# Default recipient customer.service@ups.com appears in official UPS contact documentation,
# but confirm the correct service mailbox with UPS Poland before production use.
# UPS_SUPPORT_TO=customer.service@ups.com
# UPS_SUPPORT_SMTP_HOST=smtp.example.com
# UPS_SUPPORT_SMTP_PORT=587
# UPS_SUPPORT_SMTP_SECURITY=starttls
# UPS_SUPPORT_SMTP_FROM=ups-pod@your-company.example
# UPS_SUPPORT_SMTP_USER=
# UPS_SUPPORT_SMTP_PASSWORD=

# OAuth 2.0 Gmail (klient Google Cloud "Web application").
# Wprowadzaj przez zakładkę Konfiguracja, a nie w repozytorium.
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Google redirect URI: https://ups.xlap.pl/api/config/gmail/callback
# Scopes: openid email https://www.googleapis.com/auth/gmail.send
# OAuth refresh token is stored separately in /data/.gmail_oauth.json (0600).
